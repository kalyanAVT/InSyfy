# Qdrant Cloud (free tier)
QDRANT_URL= paste_QDRANT_Endpoint_url
QDRANT_API_KEY= paste_QDRANT_API_KEY
# Search
TAVILY_API_KEY= Tavily_api_key

# LLM (Groq default, OpenAI fallback)
GROQ_API_KEY= gorq_api_key
#OPENAI_API_KEY= open_ai_api_key

# Model config
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Redis (local or cloud)
REDIS_URL=redis://default:password@EndPoint.redis.io:port

# Quality thresholds
CITATION_THRESHOLD=0.30 #(changed form .50 to .30 for testing)
QUALITY_THRESHOLD=0.75
MAX_RETRIES=2

# How many sub-queries run in parallel search (planner targets 3-5 sub-queries per plan)
# Each extra search = 1 more Tavily API call + scraping, so raise with care
MAX_PARALLEL_SEARCHES=5

# Set this to your actual LLM provider's blended rate (USD per 1,000 tokens)
# to get real cost estimates in /api/v1/metrics. Defaults to 0 (no cost
# estimate reported) rather than assuming a rate that may be wrong.
COST_PER_1K_TOKENS=0

# CORS: comma-separated list of allowed origins, or "*" for public access
# (default). No cookie/session auth exists in this app, so credentials are
# never sent regardless of this setting.
ALLOWED_ORIGINS=*

# Email (for the "Send report by email" feature). A Gmail App Password
# works with these defaults — regular account passwords will not work if
# 2FA is enabled. Leave blank to disable email sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# HF
HF_HUB_DISABLE_SYMLINKS_WARNING=1
